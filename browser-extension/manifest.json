{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Movviz",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "fr",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.themoviedb.org/movie/*",
        "https://www.themoviedb.org/tv/*",
        "https://www.imdb.com/title/*",
        "https://www.imdb.com/*/title/*",
        "https://www.allocine.fr/film/*",
        "https://www.allocine.fr/series/*",
        "https://www.senscritique.com/*",
        "https://thetvdb.com/movies/*",
        "https://thetvdb.com/series/*",
        "https://letterboxd.com/film/*",
        "https://www.rottentomatoes.com/m/*",
        "https://www.rottentomatoes.com/tv/*",
        "https://www.justwatch.com/*",
        "https://trakt.tv/movies/*",
        "https://trakt.tv/shows/*",
        "https://www.taste.io/movies/*",
        "https://www.taste.io/tv/*"
      ],
      "js": [
        "content/core.js",
        "content/sites.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://www.themoviedb.org/*",
        "https://www.imdb.com/*",
        "https://www.allocine.fr/*",
        "https://www.senscritique.com/*",
        "https://thetvdb.com/*",
        "https://letterboxd.com/*",
        "https://www.rottentomatoes.com/*",
        "https://www.justwatch.com/*",
        "https://trakt.tv/*",
        "https://www.taste.io/*"
      ]
    }
  ]
}
