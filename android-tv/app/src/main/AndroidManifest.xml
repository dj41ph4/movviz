<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Chaîne "Movviz" sur le dashboard Android TV : écriture dans le
         TvProvider (permission système déclarée, aucune demande runtime) —
         c'est ce qui permet à l'app de pousser des cartes "à reprendre". -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_TV_PROVIDER" />
    <!-- Auto-update (variante AU uniquement) : demande l'autorisation
         "installer des applications inconnues" puis installe l'APK de la
         dernière release GitHub via ACTION_VIEW. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MovvizTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MovvizTv"
        android:usesCleartextTraffic="true"
        android:largeHeap="true">
        <!-- largeHeap : le hero (WebView de bandes-annonces + carrousel) et
             les grandes affiches 4K consomment de la mémoire ; l'app TV est
             la seule app visible à l'écran, le heap agrandi ne gêne rien. -->
        <!-- usesCleartextTraffic : la plupart des instances Movviz tournent en
             HTTP simple sur le réseau local (port 9810) — voir la même
             tolérance déjà en place côté web/desktop. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MovvizTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Deep link depuis le dashboard (chaîne TvProvider) : une carte
                 de la rangée "Continuer à regarder" ouvre la fiche du titre
                 via movviz://title/{type}/{tmdbId}. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="movviz" android:host="title" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MovvizTv.Player" />

        <!-- Partage de l'APK téléchargé (cache/update) avec l'installeur
             système — l'authority suit l'applicationId, donc chaque variante
             (retail/AU) a la sienne : ${applicationId}.fileprovider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Auto-update : quand l'installation (PackageInstaller) a remplacé
             le package, le process est tué puis le système envoie
             MY_PACKAGE_REPLACED à la NOUVELLE version — ce receiver relance
             alors MainActivity (reboot de l'app, façon Netflix). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
